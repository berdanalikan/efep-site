VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"

# Vercel: Project Settings → Environment Variables → add the same VITE_* keys for Production (and Preview).
# Client bundle only embeds VITE_* — never put SUPABASE_SERVICE_ROLE_KEY in any NEXT_PUBLIC / VITE public var.

# Server-side env vars (used by server routes/middleware)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
